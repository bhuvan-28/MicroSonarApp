<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Micro-Sonar"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Acoustic Spatial Mapper"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginBottom="32dp" />

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/waveformChart"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvDimensions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="-- x -- x -- m"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#00E5FF" />

    <TextView
        android:id="@+id/tvVolume"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Room Volume: -- m³"
        android:textSize="18sp"
        android:textColor="#CCCCCC"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvMaterial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Material: --"
        android:textSize="18sp"
        android:textColor="#00E676"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvRT60"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reverb Time (RT60): -- s"
        android:textSize="18sp"
        android:textColor="#FF9100"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvRoomType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Environment: --"
        android:textSize="14sp"
        android:textColor="#E0E0E0"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvConfidence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Confidence: --%"
        android:textSize="16sp"
        android:textColor="#FFCA28"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvMicLevel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mic Input Peak: --"
        android:textSize="14sp"
        android:textColor="#888888"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="40dp" />

    <Button
        android:id="@+id/btnPing"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="PULSE SONAR"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="#00E5FF"
        android:textColor="#000000" />

    <Button
        android:id="@+id/btnDiagnostic"
        android:layout_width="220dp"
        android:layout_height="60dp"
        android:text="RUN DIAGNOSTIC SCAN"
        android:textSize="14sp"
        android:textStyle="bold"
        android:backgroundTint="#FFB300"
        android:textColor="#000000"
        android:layout_marginTop="16dp" />

</LinearLayout>